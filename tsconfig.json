{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "monaco-editor/typescript-contribution": ["./node_modules/monaco-editor/esm/vs/language/typescript/monaco.contribution.js"],
      "monaco-editor/javascript-language": ["./node_modules/monaco-editor/esm/vs/basic-languages/javascript/javascript.js"],
      "@molstar/state-builder": ["./src/state-builder/index.ts"],
      "@molstar/state-builder/compiler/ast/factory": ["./src/state-builder/compiler/ast/factory.ts"],
      "@molstar/state-builder/compiler/codegen/generator": ["./src/state-builder/compiler/codegen/generator.ts"],
      "@molstar/state-builder/types/composite-sequences": ["./src/state-builder/types/composite-sequences.ts"],
      "@molstar/state-builder/*": ["./src/state-builder/*"]
    }
  },
  "include": ["src", "docs"]
}
